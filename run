#!/bin/bash

# Global Variables

HELP="-h"
AUTONOMY_PROJECT="auto"
GPS_PROJECT="gps"
IMU_PROJECT="imu"
LLIDAR_PROJECT="llidar"
CAMERAS_PROJECT="cameras"
RPI_PROJECT="rpi"

# Build Functions

run_autonomy()
{
    echo "RUNNING AUTONOMY..."
    gnome-terminal --title="AUTONOMY" -- bash -c \
        "cd jetson/IGVC/ros2_ws ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch startup_robot deploy.launch.py ; exec bash"
}

run_gps()
{
    echo "RUNNING GPS..."
    gnome-terminal --title="GPS" -- bash -c \
        "cd jetson/sensors ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch ublox_gps ublox_gps_node_zedf9p-launch.py ; exec bash"
}

run_imu()
{
    echo "RUNNING IMU..."
    gnome-terminal --title="IMU" -- bash -c \
        "cd jetson/sensors ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch xsens_mti_ros2_driver display.launch.py; exec bash"
}

run_llidar()
{
    echo "RUNNING LLIDAR..."
    gnome-terminal --title="LLIDAR" -- bash -c \
        "cd jetson/sensors ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch sllidar_ros2 sllidar_s1_launch.py ; exec bash"
}

run_cameras()
{
    echo "RUNNING CAMERAS..."
    gnome-terminal --title="CAMERAS" -- bash -c \
        "cd jetson/cameras ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch pylon_ros2_camera_wrapper two_cams.launch.py ; exec bash"
}

run_rpi()
{
    echo "RUNNING RPI..."
    gnome-terminal --title="RPI" -- bash -c \
        "ssh littleblue@192.168.215.201 ; cd IGVCDev2 ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch arduino_control launch.py ; exec bash"
}

# Script

projects="$@"
if test $# -eq 0
then
    projects=(${AUTONOMY_PROJECT} ${GPS_PROJECT} ${IMU_PROJECT} ${LLIDAR_PROJECT} ${CAMERAS_PROJECT} ${RPI_PROJECT})
fi

for var in ${projects[@]}
do
    if test "${var}" == "${AUTONOMY_PROJECT}"
    then
        run_autonomy
    elif test "${var}" == "${GPS_PROJECT}"
    then
        run_gps
    elif test "${var}" == "${IMU_PROJECT}"
    then
        run_imu
    elif test "${var}" == "${LLIDAR_PROJECT}"
    then
        run_llidar
    elif test "${var}" == "${CAMERAS_PROJECT}"
    then
        run_cameras
    elif test "${var}" == "${RPI_PROJECT}"
    then
        run_rpi
    elif test "${var}" == "${HELP}"
    then
        echo "THIS SCRIPT RUNS PROJECTS."
        echo "OPTIONS:"
        echo -e "\t ${AUTONOMY_PROJECT}"
        echo -e "\t ${GPS_PROJECT}"
        echo -e "\t ${IMU_PROJECT}"
        echo -e "\t ${LLIDAR_PROJECT}"
        echo -e "\t ${RPI_PROJECT}"
    else
        echo "unknown project \"${var}\""
    fi
done
