#!/bin/bash

# Global Variables

HELP="-h"

RVIZ="-rviz"
RVIZ_ENABLED=0

AUTONOMY_PROJECT_1="autonomy"
AUTONOMY_PROJECT_2="auto"

CAMERAS_PROJECT_1="cameras"
CAMERAS_PROJECT_2="camera"

GPS_PROJECT="gps"

IMU_PROJECT="imu"

LIDAR_PROJECT="lidar"

RPI_PROJECT="rpi"

# Build Functions

run_autonomy()
{
    echo "RUNNING AUTONOMY..."

    if test RVIZ_ENABLED == 1
    then
        gnome-terminal --title="AUTONOMY" -- bash -c \
            "cd little-blue/jetson/autonomy/ros2_ws ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch startup_robot deploy.launch.py rviz:=true ; exec bash"
    else
        gnome-terminal --title="AUTONOMY" -- bash -c \
            "cd little-blue/jetson/autonomy/ros2_ws ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch startup_robot deploy.launch.py ; exec bash"
    fi
}

run_gps()
{
    echo "RUNNING GPS..."
    gnome-terminal --title="GPS" -- bash -c \
        "cd little-blue/jetson/gps ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch ublox_gps ublox_gps_node_zedf9p-launch.py ; exec bash"

    echo "Allowing ${GPS_PROJECT} to start up (15s)..."
    sleep 15s
}

run_imu()
{
    echo "RUNNING IMU..."
    gnome-terminal --title="IMU" -- bash -c \
            "cd little-blue/jetson/imu ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch xsens_mti_ros2_driver display.launch.py ; exec bash"

    echo "Allowing ${IMU_PROJECT} to start up (10s)..."
    sleep 10s
}

run_lidar()
{
    echo "RUNNING LIDAR..."
    gnome-terminal --title="LIDAR" -- bash -c \
        "cd little-blue/jetson/lidar ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch sllidar_ros2 sllidar_s1_launch.py ; exec bash"

    echo "Allowing ${LIDAR_PROJECT} to start up (10s)..."
    sleep 10s
}

run_cameras()
{
    echo "RUNNING CAMERAS..."
    gnome-terminal --title="CAMERAS" -- bash -c \
        "cd little-blue/jetson/cameras ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch pylon_ros2_camera_wrapper two_cams.launch.py ; exec bash"

    echo "Allowing ${CAMERAS_PROJECT_1} to start up (15s)..."
    sleep 15s
}

run_rpi()
{
    echo "RUNNING RPI..."
    gnome-terminal --title="RPI" -- bash -c \
        "ssh littleblue@192.168.215.201 'cd IGVCDev2 ; source /opt/ros/iron/setup.bash ; source install/setup.bash ; ros2 launch arduino_control launch.py '; exec bash"

    echo "Allowing ${RPI_PROJECT} to start up (15s)..."
    sleep 15s
}

# Script

projects="$@"
if test $# -eq 0
then
    RVIZ_ENABLED=0
    projects=(${RPI_PROJECT} ${GPS_PROJECT} ${IMU_PROJECT} ${CAMERAS_PROJECT_1} ${LIDAR_PROJECT} ${AUTONOMY_PROJECT_1})
elif test $# -eq 1
then
    if test "$1" == "${RVIZ}"
    then
        RVIZ_ENABLED=1
        projects=(${RPI_PROJECT} ${GPS_PROJECT} ${IMU_PROJECT} ${CAMERAS_PROJECT_1} ${LIDAR_PROJECT} ${AUTONOMY_PROJECT_1})
    fi
fi

for var in ${projects[@]}
do
    if test "${var}" == "${RVIZ}"
    then
        RVIZ_ENABLED=1
    fi
done

for var in ${projects[@]}
do
    if test "${var}" == "${AUTONOMY_PROJECT_1}" || test "${var}" == "${AUTONOMY_PROJECT_2}"
    then
        run_autonomy
    elif test "${var}" == "${CAMERAS_PROJECT_1}" || test "${var}" == "${CAMERAS_PROJECT_2}"
    then
        run_cameras
    elif test "${var}" == "${GPS_PROJECT}"
    then
        run_gps
    elif test "${var}" == "${IMU_PROJECT}"
    then
        run_imu
    elif test "${var}" == "${LIDAR_PROJECT}"
    then
        run_lidar
    elif test "${var}" == "${RPI_PROJECT}"
    then
        run_rpi
    elif test "${var}" == "${RVIZ}"
    then
        :
    elif test "${var}" == "${HELP}"
    then
        echo "THIS SCRIPT RUNS PROJECTS."
        echo "PARAMETERS:"
        echo -e "\t ${RVIZ}"
        echo "OPTIONS:"
        echo -e "\t ${AUTONOMY_PROJECT_1} or ${AUTONOMY_PROJECT_2}"
        echo -e "\t ${CAMERAS_PROJECT_1} or ${CAMERAS_PROJECT_2}"
        echo -e "\t ${GPS_PROJECT}"
        echo -e "\t ${IMU_PROJECT}"
        echo -e "\t ${LIDAR_PROJECT}"
        echo -e "\t ${RPI_PROJECT}"
        exit 0;
    else
        echo "unknown project \"${var}\""
    fi
done
