#!/bin/bash

# Global Variables

HELP="-h"
AUTONOMY_PROJECT="auto"
GPS_DRIVER="gpsdriver"
SENSORS_PROJECT="sensors"

FAILED=""

# Build Functions

build_autonomy()
{
    echo "BUILDING AUTONOMY..."
    cd jetson/IGVC/ros2_ws
    source /opt/ros/iron/setup.bash
    colcon build --symlink-install

    if [ $? -ne 0 ];
    then
        FAILED+=" ${AUTONOMY_PROJECT}"
    fi

    cd - > /dev/null
}

build_gps_driver()
{
    echo "BUILDING GPS DRIVER..."
    pushd jetson/sensors/src/xsens_ws/src/xsens_mti_ros2_driver/lib/xspublic && make && popd

    if [ $? -ne 0 ];
    then
        FAILED+=" ${GPS_DRIVER}"
    fi
}

build_sensors()
{
    echo "BUILDING SENSORS..."
    cd jetson/sensors
    source /opt/ros/iron/setup.bash
    colcon build --symlink-install

    if [ $? -ne 0 ];
    then
        FAILED+=" ${SENSORS_PROJECT}"
    fi

    cd - > /dev/null
}

# Script

projects="$@"
if test $# -eq 0
then
    projects=(${AUTONOMY_PROJECT} ${GPS_DRIVER} ${SENSORS_PROJECT})
fi

for var in ${projects[@]}
do
    if test "${var}" == "${AUTONOMY_PROJECT}"
    then
        build_autonomy
    elif test "${var}" == "${GPS_DRIVER}"
    then
        build_gps_driver
    elif test "${var}" == "${SENSORS_PROJECT}"
    then
        build_sensors
    elif test "${var}" == "${HELP}"
    then
        echo "THIS SCRIPT BUILDS PROJECTS."
        echo "OPTIONS:"
        echo -e "\t ${AUTONOMY_PROJECT}"
        echo -e "\t ${GPS_DRIVER}"
        echo -e "\t ${SENSORS_PROJECT}"
    else
        echo "unknown project \"${var}\""
    fi

    echo ""
    echo ""
    echo ""
done


for var in ${projects[@]}
do
    if [[ "$FAILED" == *"${var}"* ]]
    then
        echo "${var}: FAILED"
    else
        echo "${var}: SUCCESS"
    fi
done
