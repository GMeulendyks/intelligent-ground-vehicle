#!/bin/bash

# Global Variables

HELP="-h"

AUTONOMY_PROJECT_1="autonomy"
AUTONOMY_PROJECT_2="auto"

CAMERAS_PROJECT_1="cameras"
CAMERAS_PROJECT_2="camera"

GPS_PROJECT="gps"

IMU_PROJECT="imu"

LIDAR_PROJECT="lidar"

FAILED=""

# Build Functions

build_autonomy()
{
    (
        echo "BUILDING AUTONOMY..."
        cd little-blue/jetson/autonomy/ros2_ws/
        source /opt/ros/iron/setup.bash
        colcon build --symlink-install
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${AUTONOMY_PROJECT_1}"
    fi
}

build_cameras()
{
    (
        echo "BUILDING CAMERAS..."
        cd little-blue/jetson/cameras/
        source /opt/ros/iron/setup.bash
        colcon build --symlink-install
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${CAMERAS_PROJECT}"
    fi
}

build_gps()
{
    (
        echo "BUILDING GPS..."
        cd little-blue/jetson/gps/
        source /opt/ros/iron/setup.bash
        colcon build --symlink-install
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${GPS_PROJECT}"
    fi
}

build_imu_driver()
{
    (
        echo "BUILDING IMU DRIVER..."
        pushd little-blue/jetson/imu/src/xsens_mti_ros2_driver/lib/xspublic && make && popd
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" IMUDRIVER"
    fi
}

build_imu()
{
    (
        echo "BUILDING IMU..."
        cd little-blue/jetson/imu/
        source /opt/ros/iron/setup.bash
        colcon build --symlink-install
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${IMU_PROJECT}"
    fi
}

build_lidar()
{
    (
        echo "BUILDING LIDAR..."
        cd little-blue/jetson/lidar
        source /opt/ros/iron/setup.bash
        colcon build --symlink-install
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${LIDAR_PROJECT}"
    fi
}

# Script

projects="$@"
if test $# -eq 0
then
    projects=(${AUTONOMY_PROJECT_1} ${CAMERAS_PROJECT_1} ${GPS_PROJECT} ${IMU_PROJECT} ${LIDAR_PROJECT})
fi

for var in ${projects[@]}
do
    if test "${var}" == "${AUTONOMY_PROJECT_1}" || test "${var}" == "${AUTONOMY_PROJECT_2}"
    then
        build_autonomy
    elif test "${var}" == "${CAMERAS_PROJECT_1}" || test "${var}" == "${CAMERAS_PROJECT_2}"
    then
        build_cameras
    elif test "${var}" == "${GPS_PROJECT}"
    then
        build_gps
    elif test "${var}" == "${IMU_PROJECT}"
    then
        build_imu_driver
        build_imu
    elif test "${var}" == "${LIDAR_PROJECT}"
    then
        build_lidar
    elif test "${var}" == "${HELP}"
    then
        echo "THIS SCRIPT BUILDS PROJECTS."
        echo "OPTIONS:"
        echo -e "\t ${AUTONOMY_PROJECT_1} or ${AUTONOMY_PROJECT_2}"
        echo -e "\t ${CAMERAS_PROJECT_1} or ${CAMERAS_PROJECT_2}"
        echo -e "\t ${GPS_PROJECT}"
        echo -e "\t ${IMU_PROJECT}"
        echo -e "\t ${LIDAR_PROJECT}"
        exit 0
    else
        echo "unknown project \"${var}\""
    fi

    echo ""
    echo ""
    echo ""
done


for var in ${projects[@]}
do
    if [[ "$FAILED" == *"${var}"* ]]
    then
        echo "${var}: FAILED"
    else
        echo "${var}: SUCCESS"
    fi
done
