#!/bin/bash

# Build Functions

build_autonomy()
{
    echo "BUILDING AUTONOMY..."
    cd jetson/IGVC/ros2_ws
    source /opt/ros/iron/setup.bash
    colcon build --symlink-install
    cd - > /dev/null
}

build_gps_driver()
{
    echo "BUILDING GPS DRIVER..."
    pushd jetson/ros2_sensors_combined/src/xsens_ws/src/xsens_mti_ros2_driver/lib/xspublic && make && popd
}

build_sensors()
{
    echo "BUILDING SENSORS..."
    cd jetson/ros2_sensors_combined
    source /opt/ros/iron/setup.bash
    colcon build --symlink-install

    if [ $? -ne 0 ]; then
        echo "COMMON ISSUES:"
        echo -e "\t Allow XSENS Driver Folder Modification:"
        echo -e "\t\t sudo chmod -R o+rw jetson/ros2_sensors_combined/src/xsens_ws/src/xsens_mti_ros2_driver"
    fi

    cd - > /dev/null
}

# Constants

HELP="-h"
AUTONOMY_PROJECT="auto"
GPS_DRIVER="gpsdriver"
SENSORS_PROJECT="sensors"

# Script

projects="$@"
if test $# -eq 0
then
    projects=(${AUTONOMY_PROJECT} ${GPS_DRIVER} ${SENSORS_PROJECT})
fi

for var in ${projects[@]}
do
    if test "${var}" == "${AUTONOMY_PROJECT}"
    then
        build_autonomy
    elif test "${var}" == "${GPS_DRIVER}"
    then
        build_gps_driver
    elif test "${var}" == "${SENSORS_PROJECT}"
    then
        build_sensors
    elif test "${var}" == "${HELP}"
    then
        echo "THIS SCRIPT BUILDS PROJECTS."
        echo "OPTIONS:"
        echo -e "\t ${AUTONOMY_PROJECT}"
        echo -e "\t ${GPS_DRIVER}"
        echo -e "\t ${SENSORS_PROJECT}"
    else
        echo "unknown project \"${var}\""
    fi

    echo ""
    echo ""
    echo ""
done
