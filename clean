#!/bin/bash

# Global Variables

HELP="-h"
AUTONOMY_PROJECT="auto"
GPS_DRIVER="gpsdriver"
SENSORS_PROJECT="sensors"
CAMERAS_PROJECT="cameras"

FAILED=""

# Build Functions

clean_autonomy()
{
    (
        echo "CLEANING AUTONOMY..."
        cd jetson/IGVC/ros2_ws
        rm -rf build install log
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${AUTONOMY_PROJECT}"
    fi
}

clean_gps_driver()
{
    (
        echo "CLEANING GPS DRIVER..."
        cd jetson/sensors/src/xsens_ws/src/xsens_mti_ros2_driver/lib/xspublic
        make clean
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${GPS_DRIVER}"
    fi
}

clean_sensors()
{
    (
        echo "CLEANING SENSORS..."
        cd jetson/sensors
        rm -rf build install log
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${SENSORS_PROJECT}"
    fi
}

clean_cameras()
{
    (
        echo "CLEANING CAMERAS..."
        cd jetson/cameras
        rm -rf build install log
    )

    if [ $? -ne 0 ];
    then
        FAILED+=" ${CAMERAS_PROJECT}"
    fi
}

# Script

projects="$@"
if test $# -eq 0
then
    projects=(${AUTONOMY_PROJECT} ${GPS_DRIVER} ${SENSORS_PROJECT} ${CAMERAS_PROJECT})
fi

for var in ${projects[@]}
do
    if test "${var}" == "${AUTONOMY_PROJECT}"
    then
        clean_autonomy
    elif test "${var}" == "${GPS_DRIVER}"
    then
        clean_gps_driver
    elif test "${var}" == "${SENSORS_PROJECT}"
    then
        clean_sensors
    elif test "${var}" == "${CAMERAS_PROJECT}"
    then
        clean_cameras
    elif test "${var}" == "${HELP}"
    then
        echo "THIS SCRIPT CLEANS PROJECTS."
        echo "OPTIONS:"
        echo -e "\t ${AUTONOMY_PROJECT}"
        echo -e "\t ${GPS_DRIVER}"
        echo -e "\t ${SENSORS_PROJECT}"
        echo -e "\t ${CAMERAS_PROJECT}"
    else
        echo "unknown project \"${var}\""
    fi

    echo ""
    echo ""
    echo ""
done

for var in ${projects[@]}
do
    if [[ "$FAILED" == *"${var}"* ]]
    then
        echo "${var}: FAILED"
    else
        echo "${var}: SUCCESS"
    fi
done
