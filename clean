#!/bin/bash

# Build Functions

clean_autonomy()
{
    echo "CLEANING AUTONOMY..."
    cd jetson/IGVC/ros2_ws
    rm -rf build install log
}

# Script

if test $# -eq 0
then
    echo "We should clean everything."
    exit 0
fi

for var in "$@"
do
    if test "${var}" == "auto"
    then
        clean_autonomy
    else
        echo "unknown project \"${var}\""
    fi

    cd - > /dev/null
done
